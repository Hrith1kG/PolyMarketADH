# Copy this file to .env and adjust. All values below are optional; defaults live in config.py.

# --- "Sureshot" filter ---
PRICE_MIN=0.97
PRICE_MAX=0.995
MIN_VOLUME=5000
MIN_LIQUIDITY=1000
MIN_HOURS_TO_RESOLUTION=1
MAX_DAYS_TO_RESOLUTION=30

# --- Position sizing / risk caps ---
STAKE_PER_TRADE=25
MAX_OPEN_POSITIONS=10
MAX_TOTAL_EXPOSURE=200
STARTING_BALANCE=1000

# --- Loop ---
POLL_INTERVAL_SECONDS=60

# --- Execution mode: leave LIVE_TRADING=false until you have read README.md's
# "Going live" section and paper-traded long enough to trust the strategy. ---
LIVE_TRADING=false

# =============================================================
# MULTI-ACCOUNT CONFIGURATION
# Define N accounts as needed (ACCOUNT_1_..., ACCOUNT_2_..., etc.)
# =============================================================

# --- Account 1 (Primary / MetaMask) ---
ACCOUNT_1_NAME=MetaMask_Main
ACCOUNT_1_PRIVATE_KEY=0x_your_first_private_key
ACCOUNT_1_FUNDER_ADDRESS=  # Leave empty if trading as standard EOA, or paste profile address if proxy
ACCOUNT_1_STAKE=25.0       # Custom stake for Account 1 (defaults to STAKE_PER_TRADE)
ACCOUNT_1_ENABLED=true

# --- Account 2 (Secondary / Safe / Proxy) ---
ACCOUNT_2_NAME=Secondary_Safe
ACCOUNT_2_PRIVATE_KEY=0x_your_second_private_key
ACCOUNT_2_FUNDER_ADDRESS=  # Leave empty if trading as standard EOA, or paste profile address if proxy
ACCOUNT_2_STAKE=25.0       # Custom stake for Account 2
ACCOUNT_2_ENABLED=true

# --- Account 3 (Third Account) ---
# ACCOUNT_3_NAME=Account_3
# ACCOUNT_3_PRIVATE_KEY=0x_your_third_private_key
# ACCOUNT_3_FUNDER_ADDRESS=
# ACCOUNT_3_STAKE=25.0
# ACCOUNT_3_ENABLED=true

# --- Legacy Single-Account Fallback (still supported) ---
# PRIVATE_KEY=0x_your_private_key_here
# FUNDER_ADDRESS=0x_your_polymarket_profile_wallet_address_here
# RELAYER_API_KEY=your_relayer_api_key_from_polymarket_settings
# RELAYER_API_KEY_ADDRESS=your_relayer_signer_address

