# Copy this file to .env and adjust. All values below are optional; defaults live in config.py.

# --- "Sureshot" filter ---
PRICE_MIN=0.97
PRICE_MAX=0.995
MIN_VOLUME=5000
MIN_LIQUIDITY=1000
MIN_HOURS_TO_RESOLUTION=1
MAX_DAYS_TO_RESOLUTION=30

# --- Position sizing / risk caps ---
STAKE_PER_TRADE=25
MAX_OPEN_POSITIONS=10
MAX_TOTAL_EXPOSURE=200
STARTING_BALANCE=1000

# --- Loop ---
POLL_INTERVAL_SECONDS=60

# --- Execution mode: leave LIVE_TRADING=false until you have read README.md's
# "Going live" section and paper-traded long enough to trust the strategy. ---
LIVE_TRADING=false
# PRIVATE_KEY=0x_your_private_key_here
# FUNDER_ADDRESS=0x_your_polymarket_profile_wallet_address_here
# RELAYER_API_KEY=your_relayer_api_key_from_polymarket_settings
# RELAYER_API_KEY_ADDRESS=your_relayer_signer_address
